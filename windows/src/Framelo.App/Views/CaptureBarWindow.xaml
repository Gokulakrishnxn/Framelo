<Window
    x:Class="Framelo.App.Views.CaptureBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Framelo.App.Controls"
    Title="Framelo Capture">
    <!-- The floating capture bar. It is excluded from every recording. -->
    <Grid x:Name="Root" Background="{StaticResource PanelBackgroundBrush}" Padding="12,0" BorderBrush="{StaticResource FrameloBorderBrush}" BorderThickness="1">
        <StackPanel x:Name="SetupPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <controls:LogoMark Width="26" Height="26" />
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="DisplayMode" Click="OnMode" Tag="display" IsChecked="True" ToolTipService.ToolTip="Record a display" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7F4;" FontSize="14" /><TextBlock Text="Display" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="WindowMode" Click="OnMode" Tag="window" ToolTipService.ToolTip="Record a window" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE737;" FontSize="14" /><TextBlock Text="Window" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="AreaMode" Click="OnMode" Tag="area" ToolTipService.ToolTip="Record an area" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF407;" FontSize="14" /><TextBlock Text="Area" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>
            <ComboBox x:Name="SourcePicker" Width="230" VerticalAlignment="Center" />
            <ToggleButton x:Name="MicToggle" ToolTipService.ToolTip="Microphone" Padding="8,6">
                <FontIcon Glyph="&#xE720;" FontSize="16" />
            </ToggleButton>
            <ComboBox x:Name="MicPicker" Width="150" VerticalAlignment="Center" />
            <ToggleButton x:Name="SystemAudioToggle" ToolTipService.ToolTip="System audio" Padding="8,6">
                <FontIcon Glyph="&#xE767;" FontSize="16" />
            </ToggleButton>
            <Button x:Name="RecordButton" Click="OnRecord" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="#FFFF453A" />
                    <TextBlock Text="Record" />
                </StackPanel>
            </Button>
            <Button Click="OnClose" ToolTipService.ToolTip="Close" Padding="8,6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </StackPanel>

        <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="#FFFF453A" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Consolas" MinWidth="64" />
            <ProgressBar x:Name="MicLevel" Width="80" Maximum="1" VerticalAlignment="Center" />
            <Button x:Name="PauseButton" Click="OnPause" ToolTipService.ToolTip="Pause" Padding="10,6">
                <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
            </Button>
            <Button x:Name="StopButton" Click="OnStop" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Rectangle Width="10" Height="10" Fill="White" RadiusX="2" RadiusY="2" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
            <Button Click="OnDiscard" ToolTipService.ToolTip="Discard recording" Padding="10,6">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>
        </StackPanel>

        <TextBlock x:Name="CountdownText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   Foreground="{StaticResource BrandTealBrush}" />
        <TextBlock x:Name="StatusText" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Window>
