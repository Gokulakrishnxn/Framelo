<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Framelo palette, shared with the macOS app (DesignSystem/Theme.swift). -->
    <Color x:Key="BrandTealColor">#FF00D1BF</Color>
    <Color x:Key="AccentPurpleColor">#FF7C5CFF</Color>
    <Color x:Key="ClipAmberColor">#FFF5A524</Color>
    <Color x:Key="WindowBackgroundColor">#FF0E0E11</Color>
    <Color x:Key="PanelBackgroundColor">#FF17171B</Color>
    <Color x:Key="CardBackgroundColor">#FF1F1F25</Color>
    <Color x:Key="BorderColor">#FF2C2C33</Color>
    <Color x:Key="TextSecondaryColor">#FF9A9AA5</Color>

    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="ClipAmberBrush" Color="{StaticResource ClipAmberColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="FrameloBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- WinUI accent overrides so buttons, sliders and toggles use the Framelo purple. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E67C5CFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC7C5CFF" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>
</ResourceDictionary>
