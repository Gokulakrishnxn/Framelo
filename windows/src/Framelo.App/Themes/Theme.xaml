<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Framelo palette, shared with the macOS app. Surfaces adapt to light and dark; brand colours do not. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF0E0E11" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF17171B" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1F1F25" />
            <SolidColorBrush x:Key="FrameloBorderBrush" Color="#FF2C2C33" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9A9AA5" />
            <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#FF101014" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF4F4F6" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FrameloBorderBrush" Color="#FFE1E1E6" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B6B76" />
            <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#FFE9E9EE" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="BrandTealColor">#FF00D1BF</Color>
    <Color x:Key="AccentPurpleColor">#FF7C5CFF</Color>
    <Color x:Key="ClipAmberColor">#FFF5A524</Color>

    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="ClipAmberBrush" Color="{StaticResource ClipAmberColor}" />

    <!-- WinUI accent overrides so buttons, sliders and toggles use the Framelo accent (changeable in Settings). -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E67C5CFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC7C5CFF" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>
</ResourceDictionary>
