<Window
    x:Class="Framelo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Framelo.App.Controls"
    Title="Framelo">
    <Grid Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <controls:LogoMark Width="20" Height="20" />
                <TextBlock Text="Framelo" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
